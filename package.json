{
  "name": "cinelab",
  "version": "0.4.6",
  "description": "CineLab — AI 创作无限画布",
  "main": "./out/main/index.js",
  "private": true,
  "author": "CineLab",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:isolated": "node scripts/dev-isolated.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:capabilities": "vitest run src/main/__tests__/capability-audit.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json}\"",
    "check:encryption": "node scripts/check-encryption.mjs",
    "check:docs": "node scripts/check-docs.mjs && node scripts/check-model-skill.mjs && node scripts/gen-code-map.mjs --check",
    "check:code-map": "node scripts/gen-code-map.mjs --check",
    "check:model-skill": "node scripts/check-model-skill.mjs",
    "map:code": "node scripts/gen-code-map.mjs",
    "map:skill": "node scripts/check-model-skill.mjs --update",
    "check:ui": "node scripts/check-ui.mjs",
    "notify:release": "node scripts/notify-feishu.mjs",
    "models:check": "node scripts/models-check.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.mac.yml",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "13.0.2",
    "dompurify": "^3.4.18",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "immer": "^11.2.10",
    "marked": "^18.2.1",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typebox": "1.4.7",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/eslint-parser": "8.1.2",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yazl": "^3.3.1"
  }
}
